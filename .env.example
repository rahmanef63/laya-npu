# Copy to .env and edit. The installer writes this file for you; it is here so the
# settings are discoverable without reading the source.

# Model directory holding openvino_model.xml (and the static variant).
LAYA_MODEL=C:\Users\you\models\laya-ov-int8

# Local backend to prefer: NPU, GPU or CPU. Falls back automatically if absent.
LAYA_DEVICE=NPU

# Token window and option slots. Changing these requires rebuilding the static IR;
# the installer does that for you.
LAYA_MAXLEN=256
LAYA_MARKERS=8

# Port for the web app.
WEB_PORT=8649

# Bind address. Leave as 127.0.0.1 unless you need LAN access, in which case you MUST
# also set LAYA_TOKEN -- the server refuses to start otherwise.
LAYA_BIND=127.0.0.1
LAYA_TOKEN=

# Registry. Remove this line to stop the five-minute heartbeat entirely.
LAYA_PORTAL=https://laya.manef.dev

# Rotate the device identity. Set any value here after deleting
# ~/.laya-npu/device.json and the machine reports under a new ID; the old one goes
# silent and cannot be linked to the new one.
LAYA_DEVICE_SALT=

# Speech to text. Point at a Whisper int8 OpenVINO directory.
WHISPER_MODEL=C:\Users\you\models\whisper-base-int8
WHISPER_MAX_SECONDS=300

# Bring your own endpoint. Optional; the Compute page can set these per request too.
BYOK_URL=
BYOK_KEY=
BYOK_MODEL=jev

# Allow BYOK and the portal link to point at private or loopback addresses. Off by
# default, because a caller-supplied URL is an SSRF primitive.
LAYA_ALLOW_PRIVATE_URL=

# Restrict Open Corpus to these roots. Colon-separated. Defaults to your home directory.
LA_ALLOWED_ROOTS=

# CORS origin for the API when the UI is served from somewhere else. Off by default.
LAYA_ALLOW_ORIGIN=
